# HTTP port (3000 is Orders, 8080 is Kafka UI)
PORT=3001
# Browser origins allowed to call the API (comma-separated, exact match,
# e.g. https://shop.example.com). Empty: no cross-origin access.
CORS_ALLOWED_ORIGINS=

# Shared infra from ecommerce-infra (docker compose up -d): postgres-identity
DATABASE_HOST=localhost
DATABASE_PORT=5435
DATABASE_NAME=identity
DATABASE_USER=identity_user
DATABASE_PASSWORD=identity_pass
# Apply pending TypeORM migrations at startup (false: run `npm run migration:run` yourself)
DATABASE_MIGRATIONS_RUN=true

KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=ecommerce-identity
# Bounded Kafka latency: a publish to an unreachable broker gives up within ~3 s.
# The service starts even when Kafka is down.
KAFKA_CONNECTION_TIMEOUT_MS=1000
KAFKA_PRODUCER_RETRIES=1

# argon2id password hashing (OWASP-level defaults; lower only in tests)
ARGON2_MEMORY_COST_KIB=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=4

# POST /auth/register: requests allowed per client IP per window
RATE_LIMIT_REGISTER_LIMIT=5
RATE_LIMIT_REGISTER_TTL_MS=60000

# POST /auth/login: requests allowed per client IP, and per normalized email, per window
RATE_LIMIT_LOGIN_LIMIT=10
RATE_LIMIT_LOGIN_TTL_MS=60000

# POST /auth/refresh: requests allowed per client IP per window
RATE_LIMIT_REFRESH_LIMIT=30
RATE_LIMIT_REFRESH_TTL_MS=60000

# POST /auth/logout: requests allowed per client IP per window
RATE_LIMIT_LOGOUT_LIMIT=30
RATE_LIMIT_LOGOUT_TTL_MS=60000

# Access tokens. Issuer, audience and key path are required: the service refuses to start
# without them. Local values only; set real ones per deployment.
JWT_ISSUER=http://localhost:3001
JWT_AUDIENCE=ecommerce
# Empty: 900 (15 minutes)
JWT_ACCESS_TTL_SECONDS=
# Empty: 604800 (7 days)
JWT_REFRESH_TTL_SECONDS=
# Absolute session lifetime from login, in seconds (30 days). Refreshing never extends a session
# past it. Must be >= JWT_REFRESH_TTL_SECONDS, else startup fails.
JWT_SESSION_MAX_SECONDS=2592000
# Clock skew (seconds) allowed when this service verifies exp, iat and nbf of access tokens on
# protected routes. Non-negative integer, else startup fails.
JWT_CLOCK_TOLERANCE_SECONDS=5
# Path to the RS256 private key (PEM). Create it with `npm run keys:generate`;
# ./keys is git-ignored and keys are never committed.
JWT_PRIVATE_KEY_PATH=./keys/private.pem
# Retired RS256 public keys (PEM), comma-separated, in order. Published after the active key so
# tokens they signed still verify; they never sign. Empty: none. Remove a key once its tokens expire.
JWT_RETIRED_PUBLIC_KEY_PATHS=
# Cache-Control max-age (seconds) of GET /.well-known/jwks.json. Non-negative integer, else startup fails.
JWKS_CACHE_SECONDS=300

# Admin seed: at startup, when no admin exists, one ADMIN is created from these values (same
# email, name and password rules as registration). Existing users are never changed or promoted.
# Remove ADMIN_PASSWORD after the first start; it is never logged and is not needed again.
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=change-me-now-123
# Display name of the admin (default: Administrator).
# ADMIN_NAME=Administrator
